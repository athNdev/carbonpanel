ARG APP_VERSION=dev

# Generate protobuf code using buf
FROM --platform=$BUILDPLATFORM bufbuild/buf:1.50.0 AS proto-builder
WORKDIR /app
COPY buf.yaml buf.gen.yaml buf.lock ./
COPY proto/ ./proto/
RUN mkdir -p web/carbon-panel/static pkg/proto web/carbon-panel/src/lib/proto && buf generate

FROM --platform=$BUILDPLATFORM oven/bun:1.4.2-alpine AS frontend-builder

ARG APP_VERSION
ENV APP_VERSION=${APP_VERSION}

# web-build.sh requires bash, which the alpine bun image does not ship
RUN apk add --no-cache bash

WORKDIR /app/web/carbon-panel

COPY web/carbon-panel/package.json web/carbon-panel/bun.lock ./
RUN bun install --frozen-lockfile

COPY web/carbon-panel/ ./
COPY scripts/web-build.sh /app/scripts/web-build.sh
COPY --from=proto-builder /app/web/carbon-panel/src/lib/proto ./src/lib/proto/
COPY --from=proto-builder /app/web/carbon-panel/static/schemav1.yaml ./static/

RUN bun run build

FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine AS backend-builder

ARG APP_VERSION
ENV APP_VERSION=${APP_VERSION}

WORKDIR /app

COPY go.mod go.sum ./
RUN for i in 1 2 3 4 5; do go mod download && exit 0; echo "go mod download failed (attempt $i), retrying"; sleep $((i*5)); done; exit 1

COPY . .
COPY --from=proto-builder /app/pkg/proto ./pkg/proto/
COPY --from=frontend-builder /app/web/carbon-panel/build ./web/carbon-panel/build

ARG TARGETOS
ARG TARGETARCH
ARG APP_COMMIT=unknown
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags="-s -w -X github.com/athNdev/carbon-panel/internal/buildinfo.Version=$APP_VERSION -X github.com/athNdev/carbon-panel/internal/buildinfo.Commit=$APP_COMMIT -X github.com/athNdev/carbon-panel/internal/buildinfo.Date=$BUILD_DATE" \
    -o carbon-panel ./cmd/carbon-panel
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags="-s -w -X github.com/athNdev/carbon-panel/internal/buildinfo.Version=$APP_VERSION -X github.com/athNdev/carbon-panel/internal/buildinfo.Commit=$APP_COMMIT -X github.com/athNdev/carbon-panel/internal/buildinfo.Date=$BUILD_DATE" \
    -o carbon-storage ./cmd/carbon-storage

FROM --platform=$BUILDPLATFORM alpine:3.24.4 AS certificates
RUN apk --no-cache add ca-certificates

FROM alpine:3.24.4

ARG APP_VERSION
ENV APP_VERSION=${APP_VERSION}

WORKDIR /app

COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend-builder /app/carbon-panel .
COPY --from=backend-builder /app/carbon-storage /usr/local/bin/carbon-storage
COPY config.example.yaml ./

#RUN mkdir -p data/servers backups tmp

EXPOSE 8080

CMD ["./carbon-panel"]
