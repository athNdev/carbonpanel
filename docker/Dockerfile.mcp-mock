#
# Disposable CI-only fixture: a mock Connect controller on an isolated Docker
# network. It is never published, never carries credentials, and holds no data.
FROM python:3.13-alpine
COPY scripts/mcp_mock_controller.py /mock_controller.py
EXPOSE 8080
ENTRYPOINT ["python", "/mock_controller.py", "--port", "8080"]
