{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonpanel.dev/schemas/runtime-artifact-sbom-1.5.json",
  "title": "Carbon Panel runtime artifact SBOM",
  "type": "object",
  "required": ["bomFormat", "specVersion", "serialNumber", "version", "metadata", "components"],
  "properties": {
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "const": "1.5" },
    "serialNumber": { "type": "string", "pattern": "^urn:uuid:" },
    "version": { "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["component", "properties"],
      "properties": {
        "component": {
          "type": "object",
          "required": ["type", "name", "version", "bom-ref"],
          "properties": {
            "type": { "const": "application" },
            "name": { "type": "string", "pattern": "^carbonpanel-runtime-" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "bom-ref": { "type": "string" }
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "bom-ref", "hashes"],
        "properties": {
          "type": { "const": "file" },
          "name": { "type": "string" },
          "bom-ref": { "type": "string" },
          "hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["alg", "content"],
              "properties": {
                "alg": { "const": "SHA-256" },
                "content": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
