{
  "name": "showcase",
  "title": "Showcase: dashboard, live console, Studio, library, players and modpack browser",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "deviceScaleFactor": 2,
  "docs": "Capture the real packaged application from a disposable seeded stack. Core images (dashboard, console, Studio, modpacks) are always captured. Feature-tagged images require an explicit --features selection; the same selection gates the published manifest. The embedded World View requires the seeded BlueMap terrain fixture. No repainted UI, mockups or invented metrics. Credentials come from PANEL_REVIEW_USER / PANEL_REVIEW_PASSWORD.",
  "bootstrap": {
    "path": "/login",
    "detectSelector": "input[placeholder=\"Enter your username\"]",
    "usernameSelector": "input[placeholder=\"Choose admin username\"]",
    "passwordSelector": "input[placeholder=\"Choose a strong password (min 12 chars)\"]",
    "confirmSelector": "input[placeholder=\"Confirm your password\"]",
    "submitSelector": "button[type=\"submit\"]",
    "successSelector": "a[href^=\"/servers/\"]",
    "authenticatedSelector": "a[href^=\"/servers/\"]",
    "fatalSelector": "h1:has-text(\"Something went wrong\"), h1:has-text(\"Page not found\")",
    "entryTimeout": 30000
  },
  "login": {
    "path": "/login",
    "usernameSelector": "input[placeholder=\"Enter your username\"]",
    "passwordSelector": "input[placeholder=\"Enter your password\"]",
    "submitSelector": "button[type=\"submit\"]",
    "successSelector": "a[href^=\"/servers/\"]"
  },
  "steps": [
    {
      "goto": "/",
      "waitFor": "text=Cluster Overview",
      "name": "dashboard loads",
      "required": true
    },
    {
      "waitFor": "text=RUNNING",
      "timeout": 300000,
      "name": "seeded server reaches running",
      "required": true
    },
    {
      "wait": 60000,
      "name": "let metrics collector tick into the tiles",
      "required": true
    },
    {
      "assertVisible": "text=System Health",
      "name": "system health strip renders",
      "required": true
    },
    {
      "assertVisible": "text=review-paper",
      "name": "named server fleet is populated",
      "required": true
    },
    {
      "assertVisible": "text=review-creative",
      "name": "second named server is populated",
      "required": true
    },
    {
      "screenshot": "showcase-dashboard-full",
      "fullPage": true,
      "name": "full-window dashboard with shell and populated cards",
      "alt": "Full desktop dashboard with navigation, header, populated resource panels and several named seeded servers",
      "focus": "Shell navigation, cluster overview and the seeded server fleet"
    },
    {
      "setViewport": { "width": 1216, "height": 1000 },
      "name": "frame the dashboard content for README width"
    },
    {
      "screenshot": "showcase-dashboard",
      "element": "[data-testid=\"showcase-dashboard-content\"]",
      "scroll": false,
      "name": "dashboard content crop",
      "alt": "Cluster dashboard with server state and observed host resource tiles",
      "focus": "Server state and observed host resources",
      "required": true
    },
    {
      "setViewport": { "width": 1440, "height": 1000 },
      "name": "restore the standard desktop viewport"
    },
    {
      "goto": "/servers",
      "waitFor": "a[href^=\"/servers/\"]",
      "name": "server list loads",
      "required": true
    },
    {
      "click": "a[href^=\"/servers/\"]:has-text(\"review-vanilla\")",
      "name": "open seeded vanilla server",
      "required": true
    },
    {
      "waitFor": "[role=\"tab\"]",
      "name": "server detail tabs render",
      "required": true
    },
    {
      "wait": 2000,
      "name": "let detail settle",
      "required": true
    },
    {
      "click": "#server-detail-tabs-tab-console",
      "name": "open live console",
      "required": true
    },
    {
      "waitFor": "#server-detail-tabs-panel-console",
      "name": "console panel loads",
      "required": true
    },
    {
      "fill": "input[placeholder=\"Filter logs...\"]",
      "value": "Starting",
      "name": "filter live logs to startup messages",
      "required": true
    },
    {
      "waitFor": "#server-detail-tabs-panel-console .log-line:has-text(\"Starting minecraft server version\")",
      "timeout": 30000,
      "name": "verify the Minecraft startup line is in the filtered console",
      "required": true
    },
    {
      "screenshot": "showcase-server-detail",
      "element": "#server-detail-tabs-panel-console",
      "scroll": false,
      "name": "live console feature crop",
      "alt": "Running server console with filtered Minecraft startup messages and command input",
      "focus": "Live console, filtered startup logs and command controls",
      "required": true
    },
    {
      "setViewport": { "width": 1540, "height": 1000 },
      "name": "fit the Studio workspace tabs and settings"
    },
    {
      "goto": "/modpacks/studio",
      "waitFor": "text=Modpack Studio",
      "name": "studio loads",
      "required": true
    },
    {
      "click": "a[href^=\"/modpacks/studio/\"]:has-text(\"Showcase Pack\")",
      "name": "open the pack with mods",
      "required": true
    },
    {
      "waitFor": "text=Mods in Modpack",
      "name": "studio mods render",
      "required": true
    },
    {
      "waitFor": "[data-testid=\"showcase-mods-table\"] tbody tr:has(button[aria-label*=\"pin version for\" i])",
      "name": "seeded mod row and its version pin control appear",
      "required": true
    },
    {
      "waitFor": "[data-testid=\"showcase-studio-workspace\"] button[title^=\"Export .mrpack\"]",
      "name": "pack export control is available",
      "required": true
    },
    {
      "screenshot": "showcase-studio",
      "element": "[data-testid=\"showcase-studio-workspace\"]",
      "maxHeight": 690,
      "scroll": false,
      "name": "Studio workspace with pack identity, settings and mod controls",
      "alt": "Showcase Pack in Modpack Studio with pack settings, installed mod versions and sides, and export controls",
      "focus": "Pack settings, installed mods, side and pin controls, and export",
      "required": true
    },
    {
      "setViewport": { "width": 1440, "height": 1000 },
      "name": "restore the standard desktop viewport"
    },
    {
      "goto": "/modpacks",
      "waitFor": "text=Browse, import and manage modpack packages",
      "name": "modpacks loads",
      "required": true
    },
    {
      "wait": 10000,
      "name": "let sync toast dismiss",
      "required": true
    },
    {
      "assertVisible": "[data-testid=\"showcase-modpack-card\"]",
      "name": "first modpack card renders",
      "required": true
    },
    {
      "wait": 2000,
      "name": "let route styles settle",
      "required": true
    },
    {
      "screenshot": "showcase-modpacks",
      "element": "[data-testid=\"showcase-modpacks-content\"]",
      "maxHeight": 528,
      "scroll": false,
      "name": "modpack browse controls and first row",
      "alt": "Modpack browser with provider filters and the first row of real catalog results",
      "focus": "Provider filters and real catalog results",
      "required": true
    },
    {
      "setViewport": { "width": 960, "height": 900 },
      "feature": "players",
      "name": "readable inline capture width"
    },
    {
      "goto": "/players",
      "waitFor": "[data-testid=\"showcase-players-content\"]",
      "feature": "players",
      "name": "players page loads"
    },
    {
      "assertVisible": "[data-player-row=\"0\"]",
      "feature": "players",
      "name": "seeded offline fixture identity is in the roster"
    },
    {
      "screenshot": "showcase-players",
      "element": "[data-testid=\"showcase-players-content\"]",
      "maxHeight": 528,
      "scroll": false,
      "feature": "players",
      "name": "player lookup and cross-server roster",
      "alt": "Player lookup and cross-server roster with a real allowlisted fixture identity",
      "focus": "Player lookup, roster rows and allowlist state"
    },
    {
      "click": "button[aria-label=\"Expand details\"]",
      "feature": "players",
      "name": "expand the fixture identity details"
    },
    {
      "assertVisible": "button[aria-label=\"Collapse details\"]",
      "feature": "players",
      "name": "expanded identity details render"
    },
    {
      "screenshot": "showcase-player-profile",
      "element": "[data-testid=\"showcase-players-content\"]",
      "maxHeight": 720,
      "scroll": false,
      "feature": "players",
      "name": "expanded fixture identity in the real roster",
      "alt": "Cross-server player roster with a seeded offline fixture identity expanded; its avatar preview is unavailable because the offline identity has no Mojang skin",
      "focus": "Observed identity, aliases and the honest unavailable skin state"
    },
    {
      "setViewport": { "width": 960, "height": 1450 },
      "feature": "players",
      "name": "fit the server allowlist form and its roster"
    },
    {
      "goto": "/servers",
      "feature": "players",
      "name": "open servers for the allowlist capture"
    },
    {
      "click": "a[href^=\"/servers/\"]:has-text(\"review-vanilla\")",
      "feature": "players",
      "name": "open first server for allowlist"
    },
    {
      "waitFor": "#server-detail-tabs-tab-players",
      "feature": "players",
      "name": "server players tab renders"
    },
    {
      "click": "#server-detail-tabs-tab-players",
      "feature": "players",
      "name": "open server players tab"
    },
    {
      "waitFor": "#server-detail-tabs-panel-players",
      "feature": "players",
      "name": "server players panel renders"
    },
    {
      "waitFor": "#server-detail-tabs-panel-players section[aria-label=\"Add allowlist entry\"] input",
      "feature": "players",
      "name": "allowlist identity field renders"
    },
    {
      "waitFor": "#server-detail-tabs-panel-players section[aria-label=\"Add allowlist entry\"] button:has-text(\"Add to allowlist\")",
      "feature": "players",
      "name": "allowlist submit control renders"
    },
    {
      "waitFor": "#server-detail-tabs-panel-players [data-player-row]:has-text(\"ReviewFixture\"):has-text(\"Allowlisted\")",
      "feature": "players",
      "name": "seeded identity shows its server-scoped allowlist state"
    },
    {
      "screenshot": "showcase-player-allowlist",
      "element": "#server-detail-tabs-panel-players",
      "scroll": false,
      "feature": "players",
      "name": "server allowlist form and scoped roster",
      "alt": "Server Players tab with the real allowlist form and the seeded identity's scoped access state",
      "focus": "Allowlist form, scoped roster and moderation controls"
    },
    {
      "setViewport": { "width": 960, "height": 900 },
      "feature": "players",
      "name": "restore the compact player capture viewport"
    },
    {
      "goto": "/players",
      "waitFor": "[data-testid=\"showcase-players-content\"]",
      "feature": "playerdetail",
      "name": "roster for canonical player detail"
    },
    {
      "gotoEnv": "SHOWCASE_PLAYER_IDENTITY",
      "route": "/players/{value}",
      "feature": "playerdetail",
      "name": "open canonical player detail route"
    },
    {
      "waitFor": "#player-panel-overview",
      "feature": "playerdetail",
      "name": "canonical player detail loaded"
    },
    {
      "assertImageLoaded": "div[data-skin-state=\"ready\"] img[alt$=\" skin (face)\"]",
      "timeout": 30000,
      "feature": "playerdetail",
      "name": "skin preview decoded with non-zero intrinsic width"
    },
    {
      "screenshot": "showcase-player-detail",
      "element": "[data-testid=\"showcase-player-detail-content\"]",
      "maxHeight": 1000,
      "scroll": false,
      "feature": "playerdetail",
      "name": "canonical player detail with loaded skin preview",
      "alt": "Canonical player detail route showing the identity and a decoded skin face preview",
      "focus": "Identity, presence and the loaded skin image"
    },
    {
      "setViewport": { "width": 1440, "height": 1000 },
      "feature": "players",
      "name": "restore desktop viewport after narrow player captures"
    },
    {
      "goto": "/library",
      "waitFor": "[data-testid=\"showcase-library-content\"]",
      "feature": "library",
      "name": "world library loads"
    },
    {
      "assertVisible": "a[href^=\"/library/\"]:not([href=\"/library/import\"]):not([href=\"/library/new\"])",
      "feature": "library",
      "name": "seeded world library entry renders"
    },
    {
      "screenshot": "showcase-library",
      "element": "[data-testid=\"showcase-library-content\"]",
      "maxHeight": 528,
      "scroll": false,
      "feature": "library",
      "name": "world library grid",
      "alt": "World Library list with the seeded real revision entry",
      "focus": "Library entries, edition filter and revision counts"
    },
    {
      "click": "a[href^=\"/library/\"]:not([href=\"/library/import\"]):not([href=\"/library/new\"])",
      "feature": "library",
      "name": "open the seeded world entry"
    },
    {
      "waitFor": "#world-tab-revisions",
      "feature": "library",
      "name": "library entry tabs render"
    },
    {
      "click": "#world-tab-revisions",
      "feature": "library",
      "name": "open revisions tab"
    },
    {
      "waitFor": "#world-panel-revisions",
      "feature": "library",
      "name": "revisions panel renders"
    },
    {
      "screenshot": "showcase-library-revisions",
      "element": "[data-testid=\"showcase-library-detail-content\"]",
      "maxHeight": 1000,
      "scroll": false,
      "feature": "library",
      "name": "world library immutable revision",
      "alt": "Immutable world revision created from configuration in the seeded library entry",
      "focus": "Revision identity, hash, version and provenance"
    },
    {
      "click": "#world-tab-compatibility",
      "feature": "library",
      "name": "open compatibility tab"
    },
    {
      "waitFor": "#world-panel-compatibility",
      "feature": "library",
      "name": "compatibility panel renders"
    },
    {
      "fill": "input[placeholder=\"Server to bind this revision to\"]",
      "valueEnv": "SHOWCASE_SERVER_ID",
      "feature": "library",
      "name": "set compatibility target server"
    },
    {
      "fill": "input[placeholder=\"e.g. 1.21.1\"]",
      "value": "1.21.1",
      "feature": "library",
      "name": "set compatibility target version"
    },
    {
      "click": "button:has-text(\"Check compatibility\")",
      "feature": "library",
      "name": "run real read-only compatibility check"
    },
    {
      "assertVisible": "text=Overall verdict",
      "timeout": 30000,
      "feature": "library",
      "name": "actual compatibility verdict rendered"
    },
    {
      "screenshot": "showcase-library-compatibility",
      "element": "[data-testid=\"showcase-library-detail-content\"]",
      "maxHeight": 1000,
      "scroll": false,
      "feature": "library",
      "name": "world library compatibility result",
      "alt": "Real read-only compatibility verdict and findings computed for the seeded revision and server",
      "focus": "Compatibility verdict, findings and the binding gate"
    },
    {
      "goto": "/servers",
      "waitFor": "a[href^=\"/servers/\"]",
      "feature": "worldtab",
      "name": "open servers for the World tab capture"
    },
    {
      "click": "a[href^=\"/servers/\"]:has-text(\"review-vanilla\")",
      "feature": "worldtab",
      "name": "open seeded server for World tab"
    },
    {
      "waitFor": "#server-detail-tabs-tab-world",
      "feature": "worldtab",
      "name": "server World tab renders"
    },
    {
      "click": "#server-detail-tabs-tab-world",
      "feature": "worldtab",
      "name": "open the server World tab"
    },
    {
      "waitFor": "#server-detail-tabs-panel-world",
      "feature": "worldtab",
      "name": "server World panel renders"
    },
    {
      "screenshot": "showcase-world-tab",
      "element": "#server-detail-tabs-panel-world",
      "maxHeight": 1000,
      "scroll": false,
      "feature": "worldtab",
      "name": "per-server World tab with real world facts",
      "alt": "Per-server World tab showing the actual level, binding and relevant configuration",
      "focus": "Active world, binding and revision for the seeded vanilla server"
    },
    {
      "goto": "/worlds",
      "waitFor": "[data-testid=\"showcase-worlds-content\"]",
      "feature": "worldtab",
      "name": "world view list loads"
    },
    {
      "assertVisible": "a[href^=\"/worlds/\"]",
      "feature": "worldtab",
      "name": "a viewable world target exists"
    },
    {
      "screenshot": "showcase-worlds-list",
      "element": "[data-testid=\"showcase-worlds-content\"]",
      "maxHeight": 720,
      "scroll": false,
      "feature": "worldtab",
      "name": "world list renderer state",
      "alt": "World View list showing the observed renderer state for the seeded world",
      "focus": "Renderer state and target row"
    },
    {
      "goto": "/worlds",
      "feature": "worlds",
      "name": "open the World View list for the renderer capture"
    },
    {
      "waitFor": "a[href^=\"/worlds/\"]:has-text(\"review-vanilla\")",
      "feature": "worlds",
      "name": "wait for the seeded vanilla world target"
    },
    {
      "click": "a[href^=\"/worlds/\"]:has-text(\"review-vanilla\")",
      "feature": "worlds",
      "name": "open the rendered world map"
    },
    {
      "waitFor": "iframe[title^=\"World map for\"]",
      "timeout": 120000,
      "feature": "worlds",
      "name": "BlueMap iframe mounted"
    },
    {
      "assertFrameVisible": "canvas",
      "frame": "iframe[title^=\"World map for\"]",
      "timeout": 60000,
      "feature": "worlds",
      "name": "renderer canvas with real map tiles is visible"
    },
    {
      "assertNoFailedTileResponses": true,
      "feature": "worlds",
      "name": "all proxied map asset requests succeeded"
    },
    {
      "wait": 5000,
      "feature": "worlds",
      "name": "let real tiles paint"
    },
    {
      "assertNoFailedTileResponses": true,
      "feature": "worlds",
      "name": "no tile/texture failures after painting"
    },
    {
      "assertNoMapConsoleErrors": true,
      "feature": "worlds",
      "name": "no renderer CSP or map-load errors"
    },
    {
      "screenshot": "showcase-world-view",
      "element": "[data-testid=\"showcase-world-map-content\"]",
      "maxHeight": 1800,
      "scroll": false,
      "feature": "worlds",
      "name": "full panel view with rendered BlueMap terrain",
      "alt": "In-app World View panel with the embedded BlueMap renderer showing genuine rendered terrain tiles and its overlay controls",
      "focus": "Authenticated proxied terrain in the embedded renderer and the surrounding view controls"
    }
  ]
}
