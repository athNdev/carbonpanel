{
  "name": "showcase",
  "title": "Showcase: dashboard, live console, Studio controls and modpack browser",
  "viewport": {
    "width": 1440,
    "height": 1000
  },
  "deviceScaleFactor": 2,
  "docs": "Capture the real application from a disposable seeded stack. Use 2x PNGs: the current dashboard, running console with the native Server thread log filter, Studio content tabs and mod controls, and the first complete row of the modpack browser. Do not repaint UI or invent metrics. Staging is an additional manual capture documented in assets/showcase/README.md. Refresh provenance and both PNG directories when the represented UI changes. Credentials come from PANEL_REVIEW_USER / PANEL_REVIEW_PASSWORD.",
  "bootstrap": {
    "path": "/login",
    "detectSelector": "input[placeholder=\"Enter your username\"]",
    "usernameSelector": "input[placeholder=\"Choose admin username\"]",
    "passwordSelector": "input[placeholder=\"Choose a strong password (min 12 chars)\"]",
    "confirmSelector": "input[placeholder=\"Confirm your password\"]",
    "submitSelector": "button[type=\"submit\"]",
    "successSelector": "a[href^=\"/servers/\"]"
  },
  "login": {
    "path": "/login",
    "usernameSelector": "input[placeholder=\"Enter your username\"]",
    "passwordSelector": "input[placeholder=\"Enter your password\"]",
    "submitSelector": "button[type=\"submit\"]",
    "successSelector": "a[href^=\"/servers/\"]"
  },
  "steps": [
    {
      "goto": "/",
      "waitFor": "text=Cluster Overview",
      "name": "dashboard loads"
    },
    {
      "waitFor": "text=RUNNING",
      "timeout": 300000,
      "name": "seeded server reaches running"
    },
    {
      "wait": 60000,
      "name": "let metrics collector tick into the tiles"
    },
    {
      "assertVisible": "text=System Health",
      "name": "system health strip renders"
    },
    {
      "screenshot": "showcase-dashboard",
      "element": "[data-testid=\"showcase-dashboard-content\"]",
      "scroll": false,
      "name": "dashboard content crop"
    },
    {
      "goto": "/servers",
      "waitFor": "a[href^=\"/servers/\"]",
      "name": "server list loads"
    },
    {
      "click": "a[href^=\"/servers/\"]:not([href=\"/servers/new\"])",
      "name": "open first server"
    },
    {
      "waitFor": "[role=\"tab\"]",
      "name": "server detail tabs render"
    },
    {
      "wait": 2000,
      "name": "let detail settle"
    },
    {
      "click": "[role=\"tab\"]:text-is(\"Console\")",
      "name": "open live console"
    },
    {
      "waitFor": "#server-detail-tabs-panel-console",
      "name": "console panel loads"
    },
    {
      "fill": "input[placeholder=\"Filter logs...\"]",
      "value": "Server thread",
      "name": "focus actual startup logs"
    },
    {
      "screenshot": "showcase-server-detail",
      "element": "#server-detail-tabs-panel-console",
      "scroll": false,
      "name": "live console feature crop"
    },
    {
      "goto": "/modpacks/studio",
      "waitFor": "text=Modpack Studio",
      "name": "studio loads"
    },
    {
      "click": "a[href^=\"/modpacks/studio/\"]:has-text(\"Showcase Pack\")",
      "name": "open the pack with mods"
    },
    {
      "waitFor": "text=Mods in Modpack",
      "name": "studio mods render"
    },
    {
      "wait": 2000,
      "name": "let studio settle"
    },
    {
      "screenshot": "showcase-studio",
      "element": "[data-testid=\"showcase-studio-workspace\"] .lg\\:col-span-3",
      "scroll": false,
      "name": "studio content tabs and mod controls"
    },
    {
      "goto": "/modpacks",
      "waitFor": "text=Browse, import and manage modpack packages",
      "name": "modpacks loads"
    },
    {
      "wait": 10000,
      "name": "let sync toast dismiss"
    },
    {
      "assertVisible": "[data-testid=\"showcase-modpack-card\"]",
      "name": "first modpack card renders"
    },
    {
      "wait": 2000,
      "name": "let route styles settle"
    },
    {
      "screenshot": "showcase-modpacks",
      "element": "[data-testid=\"showcase-modpacks-content\"]",
      "maxHeight": 528,
      "scroll": false,
      "name": "modpack browse controls and first row"
    }
  ]
}
