{
  "name": "modpacks-studio-library",
  "title": "Modpacks Studio: recurring project library controls",
  "docs": "Run with scripts/review/journey.mjs against an owned panel review stack. Covers the Studio library heading, project search, and create, import, and browse entry controls.",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "bootstrap": {
    "path": "/login",
    "detectSelector": "[data-testid=\"auth-login-username\"]",
    "usernameSelector": "[data-testid=\"auth-bootstrap-username\"]",
    "passwordSelector": "[data-testid=\"auth-bootstrap-password\"]",
    "confirmSelector": "[data-testid=\"auth-bootstrap-password-confirm\"]",
    "submitSelector": "button[type=\"submit\"]",
    "successSelector": "nav[aria-label=\"Main Navigation\"] a[href=\"/modpacks/studio\"]"
  },
  "login": {
    "path": "/login",
    "usernameSelector": "[data-testid=\"auth-login-username\"]",
    "passwordSelector": "[data-testid=\"auth-login-password\"]",
    "submitSelector": "button[type=\"submit\"]",
    "successSelector": "nav[aria-label=\"Main Navigation\"] a[href=\"/modpacks/studio\"]"
  },
  "steps": [
    {
      "goto": "/modpacks/studio",
      "name": "navigate to modpacks studio"
    },
    {
      "waitFor": "text=Visual workspace for custom modpacks: create, import (.mrpack, CurseForge, Packwiz), edit overrides, and deploy.",
      "name": "modpacks studio library loads"
    },
    {
      "assertVisible": "h1:has-text(\"Modpack Studio\")",
      "name": "modpacks studio heading is present"
    },
    {
      "assertVisible": "button:has-text(\"Create Modpack\")",
      "name": "create modpack control is present"
    },
    {
      "assertVisible": "button:has-text(\"Import modpack\")",
      "name": "import modpack control is present"
    },
    {
      "assertVisible": "a:has-text(\"Browse Modpacks\")",
      "name": "browse modpacks navigation control is present"
    },
    {
      "assertVisible": "input[placeholder=\"Search modpack projects...\"]",
      "name": "modpack project search control is present"
    },
    {
      "screenshot": "modpacks-studio-library-controls",
      "name": "capture modpacks studio library controls"
    }
  ]
}
