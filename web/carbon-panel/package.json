{
	"name": "carbon-panel",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bash ../../scripts/web-build.sh",
		"preview": "vite preview",
		"build:homepage": "node demo/build.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig demo/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . --end-of-line auto && eslint .",
		"test": "bun test"
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.75.0",
		"@bufbuild/protoc-gen-es": "^2.10.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.515.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^24.10.1",
		"ansi-to-html": "^0.7.2",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "^17.13.0",
		"lodash-es": "^4.18.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.57.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.10.0",
		"@connectrpc/connect": "2.2.0",
		"@connectrpc/connect-web": "^2.1.0",
		"marked": "^18.1.1",
		"monaco-editor": "^0.52.2"
	}
