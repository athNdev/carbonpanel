// Reuse Starlight's head (title, canonical, og:title/url/description, twitter
// card) and add the shared social image. Prominent pages get a dedicated card;
// every other page keeps the Carbon Panel card so a share never renders bare.
import Default from '@astrojs/starlight/components/Head.astro';

const ORIGIN = process.env.WEBSITE_ORIGIN || 'https://carbonpanel.dev';
const SITE_BASE = process.env.WEBSITE_BASE_PATH || '/';
const DEFAULT_CARD = 'assets/og.png?v=20261113-2';
const DEFAULT_ALT =
	'Carbon Panel. Your worlds. Yours to run. Your Minecraft servers. Fully equipped.';

const PAGE_CARDS: Record<string, { file: string; alt: string }> = {
	docs: {
		file: 'assets/og-docs.png?v=20261113-2',
		alt: 'Carbon Panel documentation. Install, configure, and run the panel.'
	},
	introduction: {
		file: 'assets/og-introduction.png?v=20261113-2',
		alt: 'Introduction to Carbon Panel.'
	},
	'getting-started/docker-compose': {
		file: 'assets/og-docker-compose.png?v=20261113-2',
		alt: 'Getting started with Docker Compose for Carbon Panel.'
	},
	api: {
		file: 'assets/og-api.png?v=20261113-2',
		alt: 'Carbon Panel API reference generated from the protobuf definitions.'
	}
};

const route = Astro.locals.starlightRoute;
const key = route.id === 'index' || route.id === '' ? 'docs' : route.id.replace(/\/index$/, '');
const card = PAGE_CARDS[key] ?? { file: DEFAULT_CARD, alt: DEFAULT_ALT };
const image = new URL(SITE_BASE + card.file, ORIGIN).href;
const description = route.entry.data.description;
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={card.alt} />
<meta name="twitter:title" content={route.entry.data.title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={card.alt} />
