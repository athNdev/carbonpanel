---
// SPDX-License-Identifier: MPL-2.0
// The one generated version index drives the banner and the accessible switcher.
import index from '../generated/version-index.json';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
// The slug is relative to this build's base, never to the site root. Carrying
// the version prefix into an option href created /docs/versions/<v>/versions/.
const slug = (pathname.startsWith(base) ? pathname.slice(base.length) : pathname)
  .replace(/^\/+|\/+$/g, '');
const current = index.versions.find(
  (item) => item.route.replace(/\/+$/, '') === base.replace(/\/+$/, ''))
  ?? index.versions.find((item) => item.default);
if (!current || !/^[0-9a-f]{40}$/.test(current.commit)) {
  throw new Error('The version index must pin a full 40-hex commit for every published channel.');
}
if (Object.keys(index.channels).sort().join(',') !== 'nightly,stable') {
  throw new Error('The version index must publish exactly the stable and nightly channels.');
}
const channel = index.channels[current.channel];
if (!channel || channel.commit !== current.commit) {
  throw new Error('Channel marker must agree with the pinned revision.');
}
// Pinned links go to the immutable commit, never to a documentation index.
const pinnedHref = `${index.repository.replace(/\/+$/, '')}/commit/${current.commit}`;
const homeOf = (route) => '/' + route.replace(/^\/+|\/+$/g, '') + '/';
const options = index.versions.map((item) => {
  const home = homeOf(item.route);
  const carry = slug.length > 0 && item.pages?.includes(slug);
  const href = carry ? `${home.replace(/\/+$/, '')}/${slug}/` : home;
  if (href.includes('//') || !href.startsWith('/')) {
    throw new Error(`Non-canonical version switcher href: ${href}`);
  }
  return {
    label: item.channel_display,
    href,
    current: item.channel === current.channel,
  };
});
// The tab label shows the product tag VERBATIM; no CSS truncation is applied to
// hide part of it. Nightly has no product tag, so its display is the fallback.
const tabLabel = current.tag || current.display;
// The channel line carries the semver (or exact rolling revision), so the tag
// is not repeated there.
const releaseLabel = current.tag
  ? current.version
  : `rolling ${current.commit.slice(0, 12)}`;
const dev = import.meta.env.DEV;
---
<div class="version-banner" data-pagefind-ignore
     data-channel-revision={current.commit}
     data-channel-digest={channel.image.digest}
     data-channel-promotion={channel.promotion.state}
     data-channel-promoted={String(channel.promotion.promoted)}>
  <span class="version-label">{dev ? index.development.label : tabLabel}</span>
  <span class="version-channel">{dev ? 'development preview' : current.channel + ' · ' + releaseLabel}</span>
  <a class="version-pin" href={pinnedHref}>Pinned to {current.commit.slice(0, 7)} <span aria-hidden="true">↗</span></a>
  <div class="version-select-wrap">
    <label for="version-channel-select">Documentation version</label>
    <select id="version-channel-select" data-version-switcher aria-label="Documentation version"
            onchange="location.assign(this.value)">
      {options.map((option) => (
        <option value={option.href} selected={option.current}>{option.label}</option>
      ))}
    </select>
  </div>
  {dev && <span class="version-note">Preview only. It never replaces the stable docs.</span>}
</div>
<style>
  .version-banner { display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:6px 16px; padding:9px 20px; background:var(--sl-color-gray-6); color:var(--sl-color-gray-2); font-size:12px; border-bottom:1px solid var(--sl-color-gray-5); }
  .version-label { color:var(--sl-color-white); font-weight:600; }
  .version-channel { color:var(--sl-color-gray-3); text-transform:capitalize; }
  a { color:var(--sl-color-white); text-underline-offset:3px; }
  .version-select-wrap { display:inline-flex; align-items:center; gap:6px; padding-left:12px; border-left:1px solid var(--sl-color-gray-5); }
  .version-select-wrap label { color:var(--sl-color-gray-3); }
  select { color:var(--sl-color-white); background:var(--sl-color-gray-5); border:1px solid var(--sl-color-gray-4); border-radius:4px; padding:4px 8px; font:inherit; cursor:pointer; }
  select:focus-visible { outline:2px solid var(--sl-color-accent); outline-offset:2px; }
  .version-note { color:var(--sl-color-gray-3); font-style:italic; }
  @media (max-width: 640px) {
    .version-banner { flex-direction:column; align-items:flex-start; gap:4px; }
    .version-select-wrap { width:100%; padding-left:0; border-left:0; justify-content:space-between; }
    select { max-width:100%; }
  }
</style>
